"""Descarga de datos (Bloomberg) e imagen del gráfico IPSA"""

import re
from datetime import date
from pathlib import Path

import matplotlib.dates as mdates
import matplotlib.patheffects as pe
import matplotlib.pyplot as plt
import pandas as pd
import requests
from dateutil.relativedelta import relativedelta
from matplotlib import font_manager
from PIL import Image, ImageFilter

TONO = "#061763"
MM_A_PT = 72.27 / 25.4  # ggplot: size (mm) -> puntos (.pt)
LW_LINEA = 1.5 * MM_A_PT * 72 / 96  # linewidth = 1.5 de ggplot, en puntos
try:
    CARPETA = Path(__file__).resolve().parent
except NameError:  # ejecución en notebook / consola interactiva
    CARPETA = Path.cwd()
CARPETA_FUENTES = CARPETA / "fuentes"

TICKERS = [
    "mxipsagc index",
    "ibov index",
    "spxt index",
    "sx5t index",
    "clp curncy",
    "brl curncy",
    "eur curncy",
]


# -----------------------
# Datos (Bloomberg)
# -----------------------
def descargar_datos(tickers=TICKERS, anios=10, ruta_excel="datos.xlsx"):
    from xbbg import blp

    fecha_inicio = pd.Timestamp.today() - pd.DateOffset(years=anios)
    datos = blp.bdh(tickers=tickers, flds="PX_LAST", start_date=fecha_inicio)
    bolsas_bruto = normalizar_bdh(datos)
    bolsas_bruto.to_excel(ruta_excel, index=False)
    return bolsas_bruto


def normalizar_bdh(datos):
    """Deja la salida de bdh en formato largo: ticker, date, value (ticker en minúsculas)."""
    df = datos.to_pandas() if hasattr(datos, "to_pandas") else datos.copy()

    if isinstance(df.columns, pd.MultiIndex):  # formato ancho: columnas (ticker, campo)
        df = df.droplevel(-1, axis=1).rename_axis("date")
        df = df.reset_index().melt(id_vars="date", var_name="ticker", value_name="value")
    elif {"ticker", "date", "value"}.issubset(df.columns):  # formato largo
        if "field" in df.columns:
            df = df[df["field"].str.upper() == "PX_LAST"]
        df = df[["ticker", "date", "value"]]
    else:
        raise ValueError(f"Formato de bdh no reconocido. Columnas: {list(df.columns)}")

    df["ticker"] = df["ticker"].astype(str).str.lower()
    df["date"] = pd.to_datetime(df["date"])
    return df.reset_index(drop=True)


# -----------------------
# Fuente (equivalente a font_add_google + showtext)
# -----------------------
def font_add_google(nombre="Antonio", pesos=(400, 700)):
    """Descarga la fuente de Google Fonts (si no está en caché) y la registra en matplotlib."""
    CARPETA_FUENTES.mkdir(exist_ok=True)
    css = None
    for peso in pesos:
        ruta = CARPETA_FUENTES / f"{nombre}-{peso}.ttf"
        if not ruta.exists():
            if css is None:
                css = requests.get(
                    "https://fonts.googleapis.com/css",
                    params={"family": f"{nombre}:{','.join(map(str, pesos))}"},
                    headers={"User-Agent": "Mozilla/5.0 (X11; U; Linux)"},  # fuerza TTF
                    timeout=30,
                ).text
            bloques = re.findall(r"@font-face\s*{[^}]*}", css)
            url = next(
                re.search(r"url\((.*?)\)", b).group(1)
                for b in bloques
                if f"font-weight: {peso};" in b
            )
            ruta.write_bytes(requests.get(url, timeout=30).content)
        font_manager.fontManager.addfont(str(ruta))
    return nombre


# -----------------------
# Fondo: foto editada
# -----------------------
def editar_fondo(ruta, color, opacity=80, sigma=20):
    """image_colorize(opacity, color) + image_blur(sigma) de magick."""
    img = Image.open(ruta).convert("RGB")
    capa = Image.new("RGB", img.size, color)
    img = Image.blend(img, capa, opacity / 100)
    return img.filter(ImageFilter.GaussianBlur(sigma))


def bg_cover(ruta, px_w, px_h, color="#D9FEEF", opacity=80, sigma=20):
    """Background tipo 'cover': mantiene proporción y recorta centrado (no estira)."""
    img = editar_fondo(ruta, color, opacity, sigma)
    escala = max(px_w / img.width, px_h / img.height)
    img = img.resize(
        (round(img.width * escala), round(img.height * escala)), Image.LANCZOS
    )
    izq = (img.width - px_w) // 2
    sup = (img.height - px_h) // 2
    return img.crop((izq, sup, izq + px_w, sup + px_h))


# -----------------------
# Utilidades
# -----------------------
def formato_cl(valor, decimales=2):
    """prettyNum(big.mark = '.', decimal.mark = ',')."""
    return f"{valor:,.{decimales}f}".replace(",", "X").replace(".", ",").replace("X", ".")


def _eje_vacio(fig, transparente=False):
    ax = fig.add_axes([0, 0, 1, 1])
    ax.set_axis_off()
    if transparente:
        ax.patch.set_alpha(0)
    return ax


def _limites(ax, x_ini, x_fin, y_min, y_max, mult=0.05):
    """Expansión por defecto de ggplot (5 % en cada lado) en X e Y."""
    dx = (x_fin - x_ini) * mult
    dy = (y_max - y_min) * mult
    ax.set_xlim(x_ini - dx, x_fin + dx)
    ax.set_ylim(y_min - dy, y_max + dy)


# -----------------------
# Preparación de datos
# -----------------------
def preparar_ipsa(bolsas_bruto, ticker="mxipsagc index"):
    ipsa_pre = bolsas_bruto[bolsas_bruto["ticker"].str.lower() == ticker].copy()
    ipsa_pre["date"] = pd.to_datetime(ipsa_pre["date"])

    # Último dato del año anterior (en el script original no se utiliza después)
    validos = ipsa_pre.dropna(subset=["date", "value"])
    previo = validos[validos["date"].dt.year == date.today().year - 1]
    fecha_lastyr = previo["date"].iloc[-1] if not previo.empty else None

    ipsa = ipsa_pre[ipsa_pre["date"] >= ipsa_pre["date"].max() - relativedelta(years=1)]
    ipsa = ipsa.dropna(subset=["date", "value"]).sort_values("date").reset_index(drop=True)
    return ipsa, fecha_lastyr


# -----------------------
# Gráfico con foto de fondo
# -----------------------
def grafico_con_foto(ipsa, ruta_imagen, ruta_salida="grafico_ipsa.png", fuente="Antonio"):
    ultimo_value = ipsa["value"].iloc[-1]
    ultima_date = ipsa["date"].iloc[-1]
    ultima_date_format = ultima_date.strftime("%d-%m-%Y")

    fechas = mdates.date2num(ipsa["date"])
    valores = ipsa["value"].to_numpy()

    x_inicio, x_final = fechas.min(), fechas.max()
    x_total = x_final - x_inicio
    y_min, y_max = valores.min(), valores.max()
    y_total = y_max - y_min

    fig = plt.figure(figsize=(6, 4), dpi=300)

    # Foto de fondo cubriendo todo el lienzo
    ax_bg = _eje_vacio(fig)
    ax_bg.imshow(editar_fondo(ruta_imagen, "#D8DCF4"), aspect="auto")

    ax = _eje_vacio(fig, transparente=True)

    def texto(x_frac, y_frac, label, color, size, **kw):
        ax.text(
            x_inicio + x_total * x_frac,
            y_max + y_total * y_frac,
            "\n" + label,
            color=color,
            fontsize=size * MM_A_PT,
            fontweight="bold",
            family=fuente,
            ha="left",
            va="center",
            zorder=3,
            **kw,
        )

    texto(0.02, 0.30, "MSCI IPSA", TONO, 12)
    texto(0.407, 0.30, "12", TONO, 12)
    texto(0.352, 0.25, "EN", "#191919", 7)
    texto(0.489, 0.25, "MESES", "#191919", 7)
    texto(
        0.65,
        0.30,
        f"{formato_cl(ultimo_value)} pts.",
        "white",
        9,
        path_effects=[pe.withStroke(linewidth=2, foreground="black")],
    )
    texto(0.75, 0.13, ultima_date_format, "#191919", 4)

    ax.plot(fechas, valores, color=TONO, linewidth=LW_LINEA, zorder=4)
    ax.plot(fechas[-1], valores[-1], "o", color=TONO, markersize=3 * MM_A_PT, zorder=5)

    # El eje Y también abarca los textos, que se ubican sobre el máximo
    _limites(ax, x_inicio, x_final, y_min, y_max + y_total * 0.30)

    fig.savefig(ruta_salida, dpi=300)
    plt.close(fig)
    return ruta_salida


# -----------------------
# Gráfico transparente (Instagram)
# -----------------------
def grafico_transparente(
    ipsa,
    ruta_salida="ipsa_transparente.png",
    width_in=10.8,
    height_in=14.4,
    dpi=300,
):
    fechas = mdates.date2num(ipsa["date"])
    valores = ipsa["value"].to_numpy()

    fig = plt.figure(figsize=(width_in, height_in), dpi=dpi)
    fig.patch.set_alpha(0)
    ax = _eje_vacio(fig, transparente=True)

    ax.plot(fechas, valores, color=TONO, linewidth=LW_LINEA)
    ax.plot(fechas[-1], valores[-1], "o", color=TONO, markersize=3 * MM_A_PT)
    _limites(ax, fechas.min(), fechas.max(), valores.min(), valores.max())

    fig.savefig(ruta_salida, dpi=dpi, transparent=True)
    plt.close(fig)
    return ruta_salida


def generar_graficos_ipsa(bolsas_bruto, ruta_imagen="bolsa_stgo.jpg"):
    ipsa, _ = preparar_ipsa(bolsas_bruto)
    fuente = font_add_google("Antonio")
    grafico_con_foto(ipsa, ruta_imagen, "grafico_ipsa.png", fuente)
    grafico_transparente(ipsa, "ipsa_transparente.png")
    return ipsa


if __name__ == "__main__":
    bolsas_bruto = descargar_datos()
    generar_graficos_ipsa(bolsas_bruto, ruta_imagen=CARPETA / "bolsa_stgo.jpg")
