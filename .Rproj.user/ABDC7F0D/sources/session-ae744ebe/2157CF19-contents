series_dolar = c(
  "Dólar-Peso" = "usdclp",
  "Dollar Index" = "dxy",
  "Comex" = "cmxcopr",
  "BML" = "lmecopr"
  )
colores_dolar = c("#1A5715", "#03A791", "#F4631E", "#CB0404")

usdclp_bruto <- read_xlsx("dolar.xlsx", sheet = "usdclp") %>% mutate(code = "usdclp")
dxy_bruto <- read_xlsx("dolar.xlsx", sheet = "dxy") %>% mutate(code = "dxy")
comxcopr_bruto <- read_xlsx("dolar.xlsx", sheet = "cmxcopr") %>% mutate(code = "cmxcopr")
lmecopr_bruto <- read_xlsx("dolar.xlsx", sheet = "lmecopr") %>% mutate(code = "lmecopr")

dolar <- bind_rows(usdclp_bruto, dxy_bruto, comxcopr_bruto, lmecopr_bruto) %>%
  mutate(
    value = case_when(
      code == "cmxcopr" ~ value * 0.01,
      code == "lmecopr" ~ value / 2204.62262184877,
      TRUE ~ value
    )
  ) %>%
  mutate(
    tooltip = case_when(
      code == "cmxcopr" ~ paste0(
        "Mercado: Comex<br>",
        "Valor: ", prettyNum(round(value, 2), big.mark = ".", decimal.mark = ","), "<br>",
        "Fecha: ", format(date, "%d-%m-%Y")
        ),
      code == "lmecopr" ~ paste0(
        "Mercado: BML<br>",
        "Valor: ", prettyNum(round(value, 2), big.mark = ".", decimal.mark = ","), "<br>",
        "Fecha: ", format(date, "%d-%m-%Y")
      ),
      TRUE ~ paste0(
        "Valor: ", prettyNum(round(value, 2), big.mark = ".", decimal.mark = ","), "<br>",
        "Fecha: ", format(date, "%d-%m-%Y")
        )
      ),
    categoria = case_when(
      code %in% c("cmxcopr", "lmecopr") ~ "cobre",
      code == "usdclp" ~ "usdclp",
      code == "dxy" ~ "dxy"
      )
    )

