# Server

server <- function(input, output) {
  
  output$grafico <- renderPlotly({
    
    color_linea <- case_when(
      input$indicador == "usdclp" ~ "#1A5715",
      input$indicador == "dxy" ~ "#03A791",
      TRUE ~ NA_character_
    )
    
    titulo_yaxis <- case_when(
      input$indicador == "usdclp" ~ "Pesos chilenos ($)",
      input$indicador == "dxy" ~ "Puntos de índice",
      input$indicador == "cobre" ~ "Dólares por libra (US$/lb)",
      TRUE ~ "Base = 100"
    )
    
    if (input$indicador != "comparativo") {
      
      filtrado <- dolar %>%
        filter(
          date >= max(date) - years(as.numeric(input$periodo)),
          categoria == input$indicador
        ) %>%
        mutate(
          code = factor(code, levels = series_dolar, labels = names(series_dolar))
        )
      
      if (input$indicador == "cobre") {
        grafico <- plot_ly(
          data = filtrado,
          x = ~date,
          y = ~value,
          color = ~code,
          colors = c("Comex" = "#F4631E", "BML" = "#CB0404"),
          text = ~tooltip,
          hoverinfo = "text",
          type = "scatter",
          mode = "lines"
        )
      } else {
        grafico <- plot_ly(
          data = filtrado,
          x = ~date,
          y = ~value,
          text = ~tooltip,
          type = "scatter",
          mode = "lines",
          line = list(color = color_linea),
          hoverinfo = "text"
        )
      }
      
    } else {
      
      filtrado <- dolar %>%
        filter(
          code != "cmxcopr",
          date >= max(date) - years(as.numeric(input$periodo))
        ) %>%
        group_by(code) %>%
        mutate(value = value / first(value) * 100) %>%
        ungroup() %>%
        mutate(
          code = factor(code,
                        levels = c("usdclp", "dxy", "lmecopr"),
                        labels = c("Dólar-Peso", "Dollar Index", "Cobre BML")
                        ),
          tooltip = paste0(
            code, "<br>",
            "Valor: ", prettyNum(round(value, 2), big.mark = ".", decimal.mark = ","), "<br>",
            "Fecha: ", format(date, "%d-%m-%Y")
          )
        )
      
      grafico <- plot_ly(
        data = filtrado,
        x = ~date,
        y = ~value,
        color = ~code,
        colors = setNames(colores_dolar[-3], c("Dólar-Peso", "Dollar Index", "Cobre BML")),
        text = ~tooltip,
        hoverinfo = "text",
        type = "scatter",
        mode = "lines"
      )
    }
    
    grafico %>%
      layout(
        dragmode = FALSE,
        legend = list(
          orientation = "h",
          x = 0,
          y = 1.2,
          xanchor = "left",
          font = list(size = 10)
        ),
        xaxis = list(title = ""),
        yaxis = list(
          title = titulo_yaxis,
          titlefont = list(size = 12)
          ),
        paper_bgcolor = "rgba(0,0,0,0)",
        plot_bgcolor = "rgba(0,0,0,0)"
      ) %>%
      config(
        displayModeBar = FALSE,
        showTips = FALSE,
        scrollZoom = FALSE,
        doubleClick = FALSE,
        staticPlot = FALSE,
        displaylogo = FALSE,
        responsive = TRUE,
        locale = "es"
      )
  })
}

shinyApp(ui, server)