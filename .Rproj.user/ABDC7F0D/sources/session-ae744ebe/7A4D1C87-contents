# Server

server <- function(input, output) {
  
  output$grafico <- renderPlotly({
    
    colores = c("#C5172E", "#FFB823", "#27548A", "#309898")
    
    filtrado <- multiplos %>%
      filter(categoria == input$multiplo, date >= max(date) %m-% years(as.numeric(input$intervalo))) %>%
      mutate(code = factor(code, levels = series_multiplos, labels = names(series_multiplos)))
    
    filtrado_sin_outliers <- filtrado %>%
    group_by(code) %>%
      mutate(
        q1 = quantile(value, 0.25, na.rm = TRUE),
        mediana = median(value, na.rm = TRUE),
        q3 = quantile(value, 0.75, na.rm = TRUE),
        iqr = q3 - q1
      ) %>%
      filter(
        value >= (q1 - 1.5 * iqr),
        value <= (q3 + 1.5 * iqr)
      ) %>%
      mutate(
        min = min(value, na.rm = TRUE),
        max = max(value, na.rm = TRUE)
      ) %>%
      ungroup()
      
    
    seleccion <- filtrado_sin_outliers %>%
      group_by(code) %>%
      filter(date == last(date)) %>%
      ungroup() %>%
      mutate(
        tooltip_value = paste0("Actual: ", prettyNum(round(value, 1), decimal.mark = ",")),
        tooltip_min = paste0("Mínimo: ", prettyNum(round(min, 1), decimal.mark = ",")),
        tooltip_q1 = paste0("1° cuartil: ", prettyNum(round(q1, 1), decimal.mark = ",")),
        tooltip_mediana = paste0("Mediana: ", prettyNum(round(mediana, 1), decimal.mark = ",")),
        tooltip_q3 = paste0("3° cuartil: ", prettyNum(round(q3, 1), decimal.mark = ",")),
        tooltip_max = paste0("Máximo: ", prettyNum(round(max, 1), decimal.mark = ","))
      )
    
        plot_ly(
          data = filtrado_sin_outliers,
          y = ~value,
          x = ~code,
          color = ~code,
          colors = setNames(colores, names(series_multiplos)),
          type = "box",
          hoverinfo = "skip",
          boxpoints = FALSE
        ) %>%
          add_trace(
            data = seleccion,
            x = ~code,
            y = ~value,
            text = ~tooltip_value,
            hoverinfo = "text",
            type = "scatter",
            mode = "markers",
            marker = list(color = "red", size = 9, symbol = "diamond"),
            inherit = FALSE,
            showlegend = FALSE
          ) %>%
          add_trace(
            data = seleccion,
            x = ~code,
            y = ~min,
            text = ~tooltip_min,
            hoverinfo = "text",
            type = "scatter",
            mode = "markers",
            marker = list(color = "transparent", size = 7),
            inherit = FALSE,
            showlegend = FALSE
          ) %>%
          add_trace(
            data = seleccion,
            x = ~code,
            y = ~q1,
            text = ~tooltip_q1,
            hoverinfo = "text",
            type = "scatter",
            mode = "markers",
            marker = list(color = "transparent", size = 7),
            inherit = FALSE,
            showlegend = FALSE
          ) %>%
          add_trace(
            data = seleccion,
            x = ~code,
            y = ~mediana,
            text = ~tooltip_mediana,
            hoverinfo = "text",
            type = "scatter",
            mode = "markers",
            marker = list(color = "transparent", size = 7),
            inherit = FALSE,
            showlegend = FALSE
          ) %>%
          add_trace(
            data = seleccion,
            x = ~code,
            y = ~q3,
            text = ~tooltip_q3,
            hoverinfo = "text",
            type = "scatter",
            mode = "markers",
            marker = list(color = "transparent", size = 7),
            inherit = FALSE,
            showlegend = FALSE
          ) %>%
          add_trace(
            data = seleccion,
            x = ~code,
            y = ~max,
            text = ~tooltip_max,
            hoverinfo = "text",
            type = "scatter",
            mode = "markers",
            marker = list(color = "transparent", size = 7),
            inherit = FALSE,
            showlegend = FALSE
          ) %>%
          add_trace(
            data = seleccion,
            x = ~code,
            y = ~value,
            text = ~tooltip_value,
            hoverinfo = "text",
            type = "scatter",
            mode = "markers",
            marker = list(color = "red", size = 7),
            inherit = FALSE,
            showlegend = FALSE
          ) %>%
          plotly::layout(
            dragmode = FALSE,
            showlegend = FALSE,
            yaxis = list(
              title = "N° de veces",
              titlefont = list(size = 12)
              ),
            xaxis = list(title = ""),
            paper_bgcolor = "rgba(0,0,0,0)",
            plot_bgcolor = "rgba(0,0,0,0)"
          ) %>%
          plotly::config(
            displayModeBar = FALSE,
            showTips = FALSE,
            scrollZoom = FALSE,
            doubleClick = FALSE,
            staticPlot = FALSE,
            displaylogo = FALSE,
            responsive = TRUE
          )
  })
}

shinyApp(ui, server)