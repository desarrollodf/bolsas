series_multiplos <- c(
  "S&P IPSA" = "ipsa",
  "MSCI Latam" = "latam",
  "S&P 500" = "spx",
  "Euro Stoxx 50" = "euro"
)

ipsa_per <- read_xlsx("multiplos_bolsas.xlsx", sheet = paste0("per_", series_multiplos[1])) %>% mutate(code = "ipsa")
latam_per <- read_xlsx("multiplos_bolsas.xlsx", sheet = paste0("per_", series_multiplos[2])) %>% mutate(code = "latam")
spx_per <- read_xlsx("multiplos_bolsas.xlsx", sheet = paste0("per_", series_multiplos[3])) %>% mutate(code = "spx")
euro_per <- read_xlsx("multiplos_bolsas.xlsx", sheet = paste0("per_", series_multiplos[4])) %>% mutate(code = "euro")

ipsa_eveb <- read_xlsx("multiplos_bolsas.xlsx", sheet = paste0("eveb_", series_multiplos[1])) %>% mutate(code = "ipsa")
latam_eveb <- read_xlsx("multiplos_bolsas.xlsx", sheet = paste0("eveb_", series_multiplos[2])) %>% mutate(code = "latam")
spx_eveb <- read_xlsx("multiplos_bolsas.xlsx", sheet = paste0("eveb_", series_multiplos[3])) %>% mutate(code = "spx")
euro_eveb <- read_xlsx("multiplos_bolsas.xlsx", sheet = paste0("eveb_", series_multiplos[4])) %>% mutate(code = "euro")

per <- bind_rows(ipsa_per, latam_per, spx_per, euro_per) %>% mutate(categoria = "per")
eveb <- bind_rows(ipsa_eveb, latam_eveb, spx_eveb, euro_eveb) %>% mutate(categoria = "eveb")

multiplos <- bind_rows(per, eveb) %>%
  filter(date >= max(date) - years(10))

