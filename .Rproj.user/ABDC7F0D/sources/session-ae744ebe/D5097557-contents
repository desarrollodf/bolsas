# Función de gráfico

crear_grafico_foto <- function(selectivo, etiqueta, imagen, tono, factor_1, factor_2) {
  
  filtrado <- bolsas %>%
    filter(indice == selectivo)
  
  # Rango dinámico del eje X e Y
  
  rango_x <- range(filtrado$fecha, na.rm = TRUE)
  rango_y <- range(filtrado$valor, na.rm = TRUE)
  
  x_inicio <- rango_x[1]
  x_final <- rango_x[2]
  x_total <- as.numeric(x_final - x_inicio)
  y_min <- rango_y[1]
  y_max <- rango_y[2]
  y_total <- y_max - y_min
  
  anho <- year(last(filtrado$fecha))
  ultimo_valor <- last(filtrado$valor)
  valor_max <- max(filtrado$valor)
  primera_fecha <- first(filtrado$fecha)
  ultima_fecha <- last(filtrado$fecha)
  ultima_fecha_format <- format(ultima_fecha, "%d-%m-%Y")
  
  grafico_para_foto <- filtrado %>%
    ggplot(aes(x = fecha, y = valor)) +
    annotation_custom(imagen, xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf) +
    
    # Nombre
    annotate(
      "text",
      x = x_inicio + x_total * 0.01,
      y = y_max + y_total * 0.3,
      label = etiqueta,
      color = tono,
      size = 12,
      fontface = "bold",
      family = "Antonio",
      hjust = 0
    ) +
    
    # "EN"
    annotate(
      "text",
      x = x_inicio + x_total * factor_1,
      y = y_max + y_total * 0.25,
      label = "\nEN",
      color = "#191919",
      size = 7,
      fontface = "bold",
      family = "Antonio",
      hjust = 0
    ) +
    
    # Año
    annotate(
      "text",
      x = x_inicio + x_total * factor_2,
      y = y_max + y_total * 0.3,
      label = paste0("\n", anho),
      color = tono,
      size = 12,
      fontface = "bold",
      family = "Antonio",
      hjust = 0
    ) +
    
    # Último valor grande
    geom_shadowtext(
      data = tibble(x = x_inicio + x_total * 0.7, y = y_max + y_total * 0.3),
      aes(x = x, y = y),
      label = paste0("\n", prettyNum(
        ultimo_valor, big.mark = ".", decimal.mark = ",", nsmall = 2
      ), " pts."),
      color = "white",
      size = 8,
      fontface = "bold",
      family = "Antonio",
      hjust = 0
    ) +
    
    # Fecha
    annotate(
      "text",
      x = x_inicio + x_total * 0.77,
      y = y_max + y_total * 0.15,
      label = paste0("\n", ultima_fecha_format),
      color = "#191919",
      size = 4,
      fontface = "bold",
      family = "Antonio",
      hjust = 0
    ) +
    
    scale_y_continuous(expand = expansion(mult = c(0.05, 0.05))) +
    theme_void() +
    geom_line(color = tono, linewidth = 1.5) +
    geom_point(
      data = . %>%
        filter(fecha == max(fecha)),
      size = 3,
      color = tono,
      aes(x = fecha, y = valor)
    )
  return(grafico_para_foto)
}

grafico_para_foto <- crear_grafico_foto("ipsa", "\nS&P IPSA", img_ipsa_raster, "#061763", 0.3, 0.36)
ggsave(
