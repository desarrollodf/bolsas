dolar_pre <- read_xlsx("dolar.xlsx", sheet = "usdclp")

date_lastyr <- dolar_pre %>%
  mutate(anho = year(date)) %>%
  filter(anho == year(today()) - 1) %>%
  tail(1) %>%
  pull(date)

dolar <- dolar_pre %>%
  mutate(date = as.Date(date)) %>%
  filter(date >= max(date) - years(1))

anho <- year(last(dolar$date))
ultimo_value <- last(dolar$value)
