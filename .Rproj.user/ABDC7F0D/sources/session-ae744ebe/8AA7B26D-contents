series_bolsas <- c(
  "S&P IPSA" = "ipsa",
  "Bovespa" = "ibov",
  "S&P 500" = "spx",
  "Euro Stoxx 50" = "euro"
)
colores_bolsas <- c("#C5172E", "#D3AF37", "#27548A", "#309898")

ipsa_bruto <- read_xlsx("bolsas.xlsx", sheet = "ipsa") %>% mutate(code = "ipsa")
ibov_bruto <- read_xlsx("bolsas.xlsx", sheet = "ibov") %>% mutate(code = "ibov")
spx_bruto <- read_xlsx("bolsas.xlsx", sheet = "spx") %>% mutate(code = "spx")
euro_bruto <- read_xlsx("bolsas.xlsx", sheet = "euro") %>% mutate(code = "euro")

usdclp <- read_xlsx("bolsas.xlsx", sheet = "usdclp") %>% mutate(code = "usdclp")
usdbrl <- read_xlsx("bolsas.xlsx", sheet = "usdbrl") %>% mutate(code = "usdbrl")
eurusd <- read_xlsx("bolsas.xlsx", sheet = "eurusd") %>% mutate(code = "eurusd")

ipsa_usd <- bind_rows(ipsa_bruto, usdclp) %>%
  pivot_wider(names_from = code, values_from = value) %>%
  mutate(value = ipsa / usdclp) %>%
  select(date, value) %>%
  na.omit() %>%
  mutate(code = "ipsa_usd")

ibov_usd <- bind_rows(ibov_bruto, usdbrl) %>%
  pivot_wider(names_from = code, values_from = value) %>%
  mutate(value = ibov / usdbrl) %>%
  select(date, value) %>%
  na.omit() %>%
  mutate(code = "ibov_usd")

euro_usd <- bind_rows(euro_bruto, eurusd) %>%
  pivot_wider(names_from = code, values_from = value) %>%
  mutate(value = euro * eurusd) %>%
  select(date, value) %>%
  na.omit() %>%
  mutate(code = "euro_usd")

# Tabla final

bolsas_local <- bind_rows(ipsa_bruto, ibov_bruto, spx_bruto, euro_bruto) %>%
  mutate(categoria = "local")
bolsas_dolares <- bind_rows(ipsa_usd, ibov_usd, euro_usd) %>%
  mutate(categoria = "dolares")
bolsas <- bind_rows(bolsas_local, bolsas_dolares)

