server <- function(input, output) {
  
  output$grafico <- renderPlotly({
    
    color_linea <- case_when(
      input$indicador == "ipsa" ~ colores_bolsas[1],
      input$indicador == "bovespa" ~ colores_bolsas[2],
      input$indicador == "spx" ~ colores_bolsas[3],
      input$indicador == "euro" ~ colores_bolsas[4],
      TRUE ~ NA_character_
    )

      filtrado <- bolsas %>%
        filter(
          categoria == input$medicion,
          date >= max(date) - years(as.numeric(input$periodo))
          ) %>%
        group_by(code) %>%
        mutate(value = value / first(value) * 100) %>%
        ungroup() %>%
        mutate(
          code = factor(code, levels = series_bolsas, labels = names(series_bolsas)),
          tooltip = paste0(
            code, "<br>",
            "Valor: ", prettyNum(round(value, 2), big.mark = ".", decimal.mark = ","), "<br>",
            "Fecha: ", format(date, "%d-%m-%Y")
          )
        )
      
      grafico <- plot_ly(
        data = filtrado,
        x = ~date,
        y = ~value,
        color = ~code,
        colors = setNames(colores_bolsas, names(series_bolsas)),
        text = ~tooltip,
        hoverinfo = "text",
        type = "scatter",
        mode = "lines"
      ) %>%
      layout(
        dragmode = FALSE,
        legend = list(
          orientation = "h",
          x = 0,
          y = 1.2,
          xanchor = "left",
          font = list(size = 10)
        ),
        xaxis = list(title = ""),
        yaxis = list(
          title = "Base = 100",
          titlefont = list(size = 12)
        ),
        paper_bgcolor = "rgba(0,0,0,0)",
        plot_bgcolor = "rgba(0,0,0,0)"
      ) %>%
      config(
        displayModeBar = FALSE,
        showTips = FALSE,
        scrollZoom = FALSE,
        doubleClick = FALSE,
        staticPlot = FALSE,
        displaylogo = FALSE,
        responsive = TRUE,
        locale = "es"
      )
  })
}

shinyApp(ui, server)