library(shiny)
library(readxl)
library(dplyr)
library(tidyverse)
library(zoo)
library(ggplot2)
library(plotly)
library(scales)
library(lubridate)
library(rsconnect)
library(magick)
library(grid)
library(showtext)
library(shadowtext)

bolsas_bruto <- read_xlsx('bolsas.xlsx')

bolsas_pre <- bolsas_bruto %>%
  setNames(c("fecha", "ipsa", "spx", "stoxx")) %>%
  filter(fecha != first(fecha)) %>%
  mutate(fecha = as.Date(as.numeric(fecha), origin = "1899-12-30")) %>%
  filter(wday(fecha) %in% 2:6)

fecha_lastyr <- bolsas_pre %>%
  na.omit() %>%
  mutate(anho = year(fecha)) %>%
  filter(anho == year(today()) - 1) %>%
  tail(1) %>%
  pull(fecha)

bolsas <- bolsas_pre %>%
  na.locf() %>%
  pivot_longer(cols = -fecha, names_to = "indice", values_to = "valor") %>%
  filter(fecha >= fecha_lastyr) %>%
  mutate(
    valor = as.numeric(valor),
    tooltip = paste0(
      "Valor: ", prettyNum(valor, big.mark = ".", decimal.mark = ","), "<br>",
      "Fecha: ", format(fecha, "%d-%m-%Y")
    )
  )

anho <- year(last(bolsas$fecha))
ultimo_valor <- last(bolsas$valor[bolsas$indice == "ipsa"])
valor_max <- max(bolsas$valor[bolsas$indice == "ipsa"])
primera_fecha <- first(bolsas$fecha)
ultima_fecha <- last(bolsas$fecha)
ultima_fecha_format <- format(ultima_fecha, "%d-%m-%Y")

# Generar foto

imagen <- image_read("bolsa.jpg")
img_editada <- imagen %>%
  image_colorize(
    opacity = 80, color = "#D8DCF4"
  ) %>%
  image_blur(
    radius = 10, sigma = 20
  )
img_raster <- rasterGrob(img_editada, width = unit(1, "npc"), height = unit(1, "npc"))

# Cargar fuente

font_add_google(name = "Antonio", family = "Antonio")
showtext_auto()
showtext_opts(dpi = 300)

# Rango dinámico del eje X e Y

rango_x <- range(bolsas$fecha)
rango_y <- range(bolsas$valor[bolsas$indice == "ipsa"], na.rm = TRUE)

x_inicio <- rango_x[1]
x_final <- rango_x[2]
x_total <- as.numeric(x_final - x_inicio)
y_min <- rango_y[1]
y_max <- rango_y[2]
y_total <- y_max - y_min

# Crear gráfico

grafico_para_foto <- bolsas %>%
  filter(indice == "ipsa") %>%
  ggplot(aes(x = fecha, y = valor)) +
  annotation_custom(img_raster, xmin = -Inf, xmax = Inf, ymin = -Inf, ymax = Inf) +
  
  # "S&P IPSA"
  annotate(
    "text",
    x = x_inicio + x_total * 0.01,
    y = y_max + y_total * 0.3,
    label = "\nS&P IPSA",
    color = "#061763",
    size = 12,
    fontface = "bold",
    family = "Antonio",
    hjust = 0
  ) +
  
  # Año
  annotate(
    "text",
    x = x_inicio + x_total * 0.36,
    y = y_max + y_total * 0.3,
    label = paste0("\n", anho),
    color = "#061763",
    size = 12,
    fontface = "bold",
    family = "Antonio",
    hjust = 0
  ) +
  
  # "EN"
  annotate(
    "text",
    x = x_inicio + x_total * 0.3,
    y = y_max + y_total * 0.25,
    label = "\nEN",
    color = "#191919",
    size = 7,
    fontface = "bold",
    family = "Antonio",
    hjust = 0
  ) +
  
  # Último valor grande
  geom_shadowtext(
    data = tibble(x = x_inicio + x_total * 0.7, y = y_max + y_total * 0.3),
    aes(x = x, y = y),
    label = paste0("\n", prettyNum(
      ultimo_valor, big.mark = ".", decimal.mark = ",", nsmall = 2
      ), " pts."),
    color = "white",
    size = 8,
    fontface = "bold",
    family = "Antonio",
    hjust = 0
  ) +
  
  # Fecha
  annotate(
    "text",
    x = x_inicio + x_total * 0.77,
    y = y_max + y_total * 0.15,
    label = paste0("\n", ultima_fecha_format),
    color = "#191919",
    size = 4,
    fontface = "bold",
    family = "Antonio",
    hjust = 0
  ) +
  
  scale_y_continuous(expand = expansion(mult = c(0.05, 0.05))) +
  theme_void() +
  geom_line(color = "#061763", linewidth = 1.5) +
  geom_point(
    data = . %>%
      filter(fecha == max(fecha)),
    size = 3,
    color = "#061763",
    aes(x = fecha, y = valor)
  )

# Guardar imagen

ggsave(
  filename = "grafico_bolsa.png",
  plot = grafico_para_foto,
  width = 6,
  height = 4,
  dpi = 300
)
