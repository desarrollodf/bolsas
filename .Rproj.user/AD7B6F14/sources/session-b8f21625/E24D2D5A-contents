library(shiny)
library(readxl)
library(dplyr)
library(zoo)
library(ggplot2)
library(plotly)
library(scales)
library(lubridate)
library(rsconnect)

bolsas_bruto <- read_xlsx('bolsas.xlsx')

bolsas_pre <- bolsas_bruto %>%
  setNames(c("fecha", "ipsa", "spx")) %>%
  filter(fecha != first(fecha)) %>%
  mutate(
    fecha = as.Date(as.numeric(fecha), origin = "1899-12-30"),
    ipsa = as.numeric(ipsa),
    spx = as.numeric(spx)
    ) %>%
  filter(wday(fecha) %in% 2:6)

fecha_lastyr <- bolsas_pre %>%
  na.omit() %>%
  mutate(anho = year(fecha)) %>%
  filter(anho == year(today()) - 1) %>%
  tail(1) %>%
  pull(fecha)

bolsas <- bolsas_pre %>%
  na.locf() %>%
  pivot_longer(cols = -fecha, names_to = "indice", values_to = "valor") %>%
  filter(fecha >= fecha_lastyr) %>%
  mutate(
    tooltip = paste0(
      "Valor: ", prettyNum(valor, big.mark = ".", decimal.mark = ","), "<br>",
      "Fecha: ", format(fecha, "%d-%m-%Y")
    )
  )

anho <- year(last(bolsas$fecha))
ultimo_valor <- last(bolsas$valor)

Sys.setlocale("LC_TIME", "es_ES.UTF-8")

