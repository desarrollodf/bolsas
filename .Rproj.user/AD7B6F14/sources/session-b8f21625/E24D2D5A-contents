# Server
server <- function(input, output) {
  output$grafico_bolsas <- renderPlotly({
    
    filtrado <- bolsas %>%
      filter(
        indice == case_when(
          input$bolsa == "Bolsa de Santiago" ~ "ipsa",
          input$bolsa == "Bolsa de Nueva York" ~ "spx"
        )
      )
    
    if (input$bolsa == "Bolsa de Santiago") {
      color <- "#C5172E"
    } else (
      color <- "#061763"
    )
    
    grafico_bolsas <- filtrado %>%
      ggplot(aes(x = fecha, y = valor)) +
      geom_line(linewidth = 1, color = color) +
      geom_point(aes(text = tooltip), alpha = 0) +
      theme_minimal() +
      labs(
        x = NULL, y = NULL
      ) +
      scale_y_continuous(
        labels = label_number(big.mark = ".", decimal.mark = ",")
      ) +
      theme(
        panel.background = element_rect(fill = "transparent", color = NA),
        plot.background = element_rect(fill = "transparent", color = NA),
        legend.background = element_rect(fill = "transparent", color = NA),
        legend.box.background = element_rect(fill = "transparent", color = NA)
      )
    
    ggplotly(grafico_bolsas, tooltip = "text") %>%
      config(displayModeBar = FALSE)
  })
}

shinyApp(ui, server)