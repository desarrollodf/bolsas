# Server

server <- function(input, output) {
  
  output$grafico_dolar <- renderPlotly({
    
    if (input$periodo == "12_meses") {
      pre_filtrado <- dolar %>%
        filter(fecha >= max(fecha) %m-% years(1))
      grosor <- 0.8
    } else if (input$periodo == "5_anhos") {
      pre_filtrado <- dolar %>%
        filter(fecha >= max(fecha) %m-% years(5))
      grosor <- 0.6
    } else {
      pre_filtrado <- dolar %>%
        filter(fecha >= max(fecha) %m-% years(10))
      grosor <- 0.4
    }
    
    filtrado <- pre_filtrado %>%
      filter(
        activo %in% case_when(
          input$activo == "usdclp" ~ "usdclp",
          input$activo == "dxy" ~ "dxy",
          input$activo == "cobre" ~ c("cmxcopr", "lmecopr")
        )
      )
    
    grafico_dolar <- filtrado %>%
      mutate(
        activo = factor(activo,
                        levels = c("usdclp", "dxy", "cmxcopr", "lmecopr"),
                        labels = c("USDCLP", "DXY", "Comex", "Bolsa de Metales de Londres"))
        ) %>%
      ggplot(aes(x = fecha, y = valor, color = activo)) +
      theme_minimal() +
      labs(
        x = NULL, y = NULL
      ) +
      scale_y_continuous(
        labels = label_number(big.mark = ".", decimal.mark = ",")
      ) +
      theme(
        panel.background = element_rect(fill = "transparent", color = NA),
        plot.background = element_rect(fill = "transparent", color = NA),
        legend.background = element_rect(fill = "transparent", color = NA),
        legend.box.background = element_rect(fill = "transparent", color = NA)
      )
    
    if (input$activo == "cobre") {
      grafico_dolar <- grafico_dolar +
        geom_line(aes(color = activo), linewidth = grosor) +
        geom_point(aes(text = tooltip), alpha = 0) +
        scale_color_manual(
          values = c("#F75A5A", "#8E1616"),
          breaks = c("Comex", "Bolsa de Metales de Londres"),
          name = NULL
        )
    } else if (input$activo == "usdclp") {
      grafico_dolar <- grafico_dolar +
        geom_line(linewidth = grosor) +
        geom_point(aes(text = tooltip), alpha = 0) +
        scale_color_manual(values = "#1A5715") +
        theme(legend.position = "none")
    } else {
      grafico_dolar <- grafico_dolar +
        geom_line(linewidth = grosor) +
        geom_point(aes(text = tooltip), alpha = 0) +
        scale_color_manual(values = "#03A791", name = NULL) +
        theme(legend.position = "none")
    }
      
    ggplotly(grafico_dolar, tooltip = "text") %>%
      layout(
        dragmode = FALSE,
        legend = list(
          orientation = "h",
          x = 0,
          y = 1.1,
          xanchor = "left",
          font = list(size = 9),
          tracegroupgap = 0,
          itemsizing = "constant"
        )
      ) %>%
      config(
        displayModeBar = FALSE,
        scrollZoom = FALSE,
        doubleClick = FALSE,
        staticPlot = FALSE,
        displaylogo = FALSE,
        responsive = TRUE
      )
  })
}

shinyApp(ui, server)