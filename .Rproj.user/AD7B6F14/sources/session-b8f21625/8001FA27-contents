dolar_bruto <- read_xlsx('dolar.xlsx', sheet = "usdclp")
otros_bruto <- read_xlsx('dolar.xlsx', sheet = "otros")

dolar_pre_pre <- dolar_bruto %>%
  setNames(c("fecha", "valor")) %>%
  filter(fecha != first(fecha)) %>%
  mutate(activo = "usdclp") %>%
  na.locf()

otros_pre <- otros_bruto %>%
  setNames(c("fecha", "dxy", "cmxcopr", "lmecopr")) %>%
  filter(fecha != first(fecha)) %>%
  na.locf() %>%
  pivot_longer(cols = -fecha, names_to = "activo", values_to = "valor")

dolar_pre <- bind_rows(dolar_pre_pre, otros_pre) %>%
  mutate(fecha = as.Date(as.numeric(fecha), origin = "1899-12-30")) %>%
  filter(wday(fecha) %in% 2:6)

fecha_lastyr <- dolar_pre %>%
  na.omit() %>%
  mutate(anho = year(fecha)) %>%
  filter(anho == year(today()) - 1) %>%
  tail(1) %>%
  pull(fecha)

dolar <- dolar_pre %>%
  mutate(
    valor = as.numeric(valor),
    valor = case_when(
      activo == "cmxcopr" ~ valor * 0.01,
      activo == "lmecopr" ~ valor / 2204.62262184877,
      TRUE ~ valor
    )
  ) %>%
  mutate(
    tooltip = case_when(
      activo == "cmxcopr" ~ paste0(
        "Mercado: Comex<br>",
        "Valor: ", prettyNum(round(valor, 2), big.mark = ".", decimal.mark = ","), "<br>",
        "Fecha: ", format(fecha, "%d-%m-%Y")
        ),
      activo == "lmecopr" ~ paste0(
        "Mercado: BML<br>",
        "Valor: ", prettyNum(round(valor, 2), big.mark = ".", decimal.mark = ","), "<br>",
        "Fecha: ", format(fecha, "%d-%m-%Y")
      ),
      TRUE ~ paste0(
        "Valor: ", prettyNum(round(valor, 2), big.mark = ".", decimal.mark = ","), "<br>",
        "Fecha: ", format(fecha, "%d-%m-%Y")
        )
      )
    )

dolar$valor[dolar$activo == "lmecopr" & dolar$fecha == max(dolar$fecha)] <- NA

anho <- year(last(dolar$fecha))
ultimo_valor <- last(dolar$valor[dolar$activo == "usdclp"])
primera_fecha <- first(dolar$fecha)
ultima_fecha <- last(dolar$fecha)
ultima_fecha_format <- format(ultima_fecha, "%d-%m-%Y")

Sys.setlocale("LC_TIME", "es_ES.UTF-8")

