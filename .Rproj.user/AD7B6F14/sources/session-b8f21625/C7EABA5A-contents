# Server
server <- function(input, output) {
  
  output$grafico_bolsas <- renderPlotly({
    
    if (input$periodo == "12_meses") {
      filtrado <- bolsas %>%
        filter(fecha >= max(fecha) %m-% years(1))
      grosor <- 0.8
    } else if (input$periodo == "5_anhos") {
      filtrado <- bolsas %>%
        filter(fecha >= max(fecha) %m-% years(5))
      grosor <- 0.6
    } else {
      filtrado <- bolsas %>%
        filter(fecha >= max(fecha) %m-% years(10))
      grosor <- 0.4
    }
    
    if (input$bolsa == "ipsa") {
     color <- "#C5172E"
    } else if (input$bolsa == "spx") {
     color <- "#27548A"
    } else if (input$bolsa == "stoxx") {
     color <- "#309898"
    }
    
    if (input$bolsa != "comparativo") {
      
    grafico_bolsas <- filtrado %>%
      filter(indice == input$bolsa) %>%
      ggplot(aes(x = fecha, y = valor)) +
      geom_line(linewidth = grosor, color = color) +
      geom_point(aes(text = tooltip), alpha = 0) +
      theme_minimal() +
      labs(
        x = NULL, y = "Puntos de índice"
      ) +
      scale_y_continuous(
        labels = label_number(big.mark = ".", decimal.mark = ",")
      ) +
      theme(
        axis.title.y = element_text(size = 9),
        panel.background = element_rect(fill = "transparent", color = NA),
        plot.background = element_rect(fill = "transparent", color = NA),
        legend.background = element_rect(fill = "transparent", color = NA),
        legend.box.background = element_rect(fill = "transparent", color = NA)
      )
    
    } else {
      
      grafico_bolsas <- filtrado %>%
        group_by(indice) %>%
        mutate(
          valor = valor / first(valor) * 100
        ) %>%
        ungroup() %>%
        mutate(
          indice = factor(indice, levels = c("ipsa", "spx", "stoxx"),
                          labels = c("S&P IPSA", "S&P 500", "Euro Stoxx 50")),
          tooltip = paste0(
            "Índice: ", indice, "<br>",
            "Valor: ", prettyNum(round(valor, 2), big.mark = ".", decimal.mark = ","), "<br>",
            "Fecha: ", format(fecha, "%d-%m-%Y")
            )
          ) %>%
        ggplot(aes(x = fecha, y = valor, color = indice)) +
        geom_line(linewidth = grosor) +
        geom_point(aes(text = tooltip), alpha = 0) +
        theme_minimal() +
        labs(
          x = NULL, y = "Base = 100"
        ) +
        scale_y_continuous(
          labels = label_number(big.mark = ".", decimal.mark = ",")
        ) +
        scale_color_manual(
          values = c("#C5172E", "#27548A", "#309898"), name = NULL
        ) +
        theme(
          axis.title.y = element_text(size = 9),
          panel.background = element_rect(fill = "transparent", color = NA),
          plot.background = element_rect(fill = "transparent", color = NA),
          legend.background = element_rect(fill = "transparent", color = NA),
          legend.box.background = element_rect(fill = "transparent", color = NA)
        )
    }
    
    ggplotly(grafico_bolsas, tooltip = "text") %>%
      layout(
        dragmode = FALSE,
        legend = list(
          orientation = "h",
          x = 0,
          y = 1.2,
          xanchor = "left",
          font = list(size = 9),
          tracegroupgap = 0,
          itemsizing = "constant"
        )
      ) %>%
      config(
        displayModeBar = FALSE,
        showTips = FALSE,
        scrollZoom = FALSE,
        doubleClick = FALSE,
        staticPlot = FALSE,
        displaylogo = FALSE,
        responsive = TRUE
      )
  })
}

shinyApp(ui, server)